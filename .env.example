# Optional. The same two PUBLIC values can instead be written in public-config.json.
# Never put a service_role key or any password here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Paddle checkout + paid downloads ---
# Public token that opens checkout (starts with live_). Also stored in public-config.json.
VITE_PADDLE_CLIENT_TOKEN=
# SERVER-ONLY secrets, set in Vercel (Production). Never commit values.
# Read-only Paddle API key (permission: Transactions > Read), used to confirm a payment before a download.
PADDLE_API_KEY=
# Supabase service key, used only to create 60-second links to the private `paid-downloads` bucket.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
