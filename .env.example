# Optional. The same two PUBLIC values can instead be written in public-config.json.
# Never put a service_role key or any password here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- bKash / Nagad checkout, paid downloads and order e-mails (all SERVER-ONLY secrets, set in Vercel > Production) ---
# Never commit values. None of these use the VITE_ prefix, so none of them can reach the browser.
SUPABASE_URL=
# Supabase service key: creates orders and 60-second links to the private `paid-downloads` bucket.
SUPABASE_SERVICE_ROLE_KEY=
# Long random text. The phone's SMS-forwarder app sends it along with every payment SMS.
SMS_WEBHOOK_SECRET=
# E-mail sent from hello@walidrahman.com through Gmail:
SMTP_USER=
# A Google "App password" for that Gmail account (not the normal password).
SMTP_PASS=
# Optional, default: Walid Rahman Swapnil <hello@walidrahman.com>
MAIL_FROM=
# Optional, default: https://walidrahman.com (used for the link inside the e-mail)
SITE_URL=
