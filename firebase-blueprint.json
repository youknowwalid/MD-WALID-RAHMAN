{
  "entities": {
    "project": {
      "title": "Project",
      "description": "A portfolio project item",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "link": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "image"]
    },
    "service": {
      "title": "Service",
      "description": "An offered service",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "iconName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "description"]
    },
    "blogPost": {
      "title": "Blog Post",
      "description": "A journal entry",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "date": { "type": "string" },
        "excerpt": { "type": "string" },
        "image": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "date", "excerpt", "image"]
    },
    "user": {
      "title": "User",
      "description": "User profile and admin status",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "isAdmin": { "type": "boolean" }
      },
      "required": ["uid", "email"]
    },
    "resumeItem": {
      "title": "Resume Item",
      "description": "An experience or education entry",
      "type": "object",
      "properties": {
        "year": { "type": "string" },
        "role": { "type": "string" },
        "company": { "type": "string" },
        "desc": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["year", "role", "company"]
    },
    "testimonial": {
      "title": "Testimonial",
      "description": "Client feedback",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "content": { "type": "string" },
        "avatar": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "role", "content"]
    },
    "siteConfig": {
      "title": "Site Configuration",
      "description": "Global settings like hero image",
      "type": "object",
      "properties": {
        "heroImage": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "projects": {
      "schema": "project",
      "description": "Collection of portfolio projects"
    },
    "services": {
      "schema": "service",
      "description": "Collection of services"
    },
    "blogPosts": {
      "schema": "blogPost",
      "description": "Collection of blog posts"
    },
    "users": {
        "schema": "user",
        "description": "Collection of system users"
    },
    "resume": {
      "schema": "resumeItem",
      "description": "Collection of resume items"
    },
    "testimonials": {
      "schema": "testimonial",
      "description": "Collection of client testimonials"
    },
    "siteConfig": {
      "schema": "siteConfig",
      "description": "Global configuration"
    }
  }
}
