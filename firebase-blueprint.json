{
  "entities": {
    "project": {
      "title": "Project",
      "description": "A portfolio project item",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "link": { "type": "string" },
        "slug": { "type": "string" },
        "content": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "gallery": { "type": "array", "items": { "type": "string" } },
        "socialTitle": { "type": "string" },
        "socialDescription": { "type": "string" },
        "socialImage": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "image"]
    },
    "service": {
      "title": "Service",
      "description": "An offered service",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "iconName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "description"]
    },
    "blogPost": {
      "title": "Blog Post",
      "description": "A journal entry",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "date": { "type": "string" },
        "excerpt": { "type": "string" },
        "image": { "type": "string" },
        "slug": { "type": "string" },
        "content": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "author": { "type": "string" },
        "socialTitle": { "type": "string" },
        "socialDescription": { "type": "string" },
        "socialImage": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "date", "excerpt", "image"]
    },
    "user": {
      "title": "User",
      "description": "User profile and admin status",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "isAdmin": { "type": "boolean" }
      },
      "required": ["uid", "email"]
    },
    "resumeItem": {
      "title": "Resume Item",
      "description": "An experience or education entry",
      "type": "object",
      "properties": {
        "year": { "type": "string" },
        "role": { "type": "string" },
        "company": { "type": "string" },
        "desc": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["year", "role", "company"]
    },
    "testimonial": {
      "title": "Testimonial",
      "description": "Client feedback",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "content": { "type": "string" },
        "avatar": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "role", "content"]
    },
    "siteConfig": {
      "title": "Site Configuration",
      "description": "Global settings like hero image and CV",
      "type": "object",
      "properties": {
        "heroImage": { "type": "string" },
        "heroStatus": { "type": "string" },
        "heroAvailability": { "type": "string" },
        "cvUrl": { "type": "string" },
        "resumeImage": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "pricingPlan": {
      "title": "Pricing Plan",
      "description": "Investment options",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "string" },
        "features": { "type": "array", "items": { "type": "string" } },
        "unavailableFeatures": { "type": "array", "items": { "type": "string" } },
        "showPriorityBox": { "type": "boolean", "description": "Toggle to show the highlight box (Hours/Consultation)" },
        "priorityTitle": { "type": "string", "description": "e.g. 6 Hours / Day" },
        "prioritySubtitle": { "type": "string", "description": "e.g. Daily Priority Access" },
        "buttonText": { "type": "string" },
        "buttonUrl": { "type": "string" },
        "accent": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "features"]
    },
    "contactSubmission": {
      "title": "Contact Submission",
      "description": "Inquiries from the contact form",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "message"]
    },
    "skill": {
      "title": "Skill",
      "description": "A technical skill with rating",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "level": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "level"]
    },
    "product": {
      "title": "Product",
      "description": "A digital product/resource",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "shortTitle": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "string" },
        "thumbnail": { "type": "string" },
        "image": { "type": "string" },
        "gumroadUrl": { "type": "string" },
        "order": { "type": "integer" },
        "featured": { "type": "boolean" },
        "published": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "shortTitle", "description", "price", "thumbnail", "image", "gumroadUrl"]
    }
  },
  "firestore": {
    "projects": {
      "schema": "project",
      "description": "Collection of portfolio projects"
    },
    "services": {
      "schema": "service",
      "description": "Collection of services"
    },
    "blogPosts": {
      "schema": "blogPost",
      "description": "Collection of blog posts"
    },
    "users": {
        "schema": "user",
        "description": "Collection of system users"
    },
    "resume": {
      "schema": "resumeItem",
      "description": "Collection of resume items"
    },
    "testimonials": {
      "schema": "testimonial",
      "description": "Collection of client testimonials"
    },
    "siteConfig": {
      "schema": "siteConfig",
      "description": "Global configuration"
    },
    "pricingPlans": {
      "schema": "pricingPlan",
      "description": "Collection of pricing plans"
    },
    "contactSubmissions": {
      "schema": "contactSubmission",
      "description": "Collection of visitor inquiries"
    },
    "skills": {
      "schema": "skill",
      "description": "Collection of technical skills"
    },
    "products": {
      "schema": "product",
      "description": "Collection of digital products/resources"
    }
  }
}
