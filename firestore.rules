rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.get('email', '').lower() == "walidxdxdxd@gmail.com";
    }

    function incoming() {
      return request.resource.data;
    }

    // --- Validation Helpers ---

    function isValidProject(data) {
      return data.keys().hasAll(['title', 'category', 'image']) &&
             data.get('title', '') is string && 
             data.get('category', '') is string && 
             data.get('image', '') is string &&
             data.keys().size() <= 30;
    }

    function isValidBlogPost(data) {
      return data.keys().hasAll(['title', 'date', 'excerpt', 'image']) &&
             data.get('title', '') is string && 
             data.get('date', '') is string && 
             data.get('excerpt', '') is string && 
             data.get('image', '') is string &&
             data.keys().size() <= 30;
    }

    function isValidPricingPlan(data) {
      return data.keys().hasAll(['name', 'price', 'features', 'accent']) &&
             data.get('name', '') is string && 
             data.get('price', '') is string && 
             data.get('features', []) is list && 
             data.get('accent', false) is bool &&
             data.keys().size() <= 30;
    }

    function isValidService(data) {
      return data.keys().hasAll(['id', 'title', 'description', 'iconName']) &&
             data.keys().size() <= 20;
    }

    function isValidResumeItem(data) {
      return data.keys().hasAll(['year', 'role', 'company', 'desc']) &&
             data.keys().size() <= 20;
    }

    function isValidTestimonial(data) {
      return data.keys().hasAll(['name', 'role', 'content', 'avatar']) &&
             data.keys().size() <= 20;
    }

    function isValidContactSubmission(data) {
      return data.keys().hasAll(['name', 'email', 'subject', 'message']) &&
             data.keys().size() <= 20;
    }

    function isValidUser(data) {
        return data.keys().hasAll(['uid', 'email', 'isAdmin']) &&
               data.uid == request.auth.uid &&
               data.keys().size() <= 10;
    }

    // --- Collection Matches ---

    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /resume/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pricingPlans/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /contactSubmissions/{id} {
      allow read, delete: if isAdmin();
      allow create: if isValidContactSubmission(incoming());
    }

    match /siteConfig/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      // Allow self-registration and updates for the system admin and standard users
      allow create, update: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
    }
  }
}
